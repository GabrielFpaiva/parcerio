rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMember(data) {
      return isSignedIn() && request.auth.uid in data.members;
    }

    function partnership(pid) {
      return get(/databases/$(database)/documents/partnerships/$(pid)).data;
    }

    function superPartnership(spid) {
      return get(/databases/$(database)/documents/superPartnerships/$(spid)).data;
    }

    // Precisa bater com GAME_CATALOG_SIZE em shared/dailyGame.ts.
    function gameCatalogSize() {
      return 120;
    }

    // Os 10800000 ms são as 3h de America/Sao_Paulo: movem a virada do dia
    // do UTC para a meia-noite local. Verificado contra o emulador em 28/08 —
    // a regra calcula o índice e nega o índice errado.
    function todayNumber() {
      return int((request.time.toMillis() - 10800000) / 86400000);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // A data de hoje em America/Sao_Paulo, no formato do id do documento.
    // É a TERCEIRA derivação da data — shared/dailyGame.ts já tem dayNumber e
    // gameDateId. Duplicação deliberada: se as três divergirem, a suíte fica
    // vermelha, que é o comportamento desejado.
    function todayId() {
      let t = request.time - duration.value(3, 'h');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    function questionOfTheDay() {
      return 'q' + string(todayNumber() % gameCatalogSize());
    }

    // XP da rodada, nunca do votante: 8 votos valem o mesmo que 3.
    function gameXp(voterCount, memberCount) {
      return voterCount >= memberCount ? 15 : 6;
    }

    // Fechada = todo mundo votou, OU o dia da rodada já passou. Não existe job
    // que feche: o fechamento é derivado na leitura, como o decaimento da
    // Temperatura. hasAll (contenção), não comparação de tamanho: contar
    // tamanhos é proxy de "todo mundo votou" e só funciona enquanto os dois
    // conjuntos não puderem divergir. Hoje não podem, porque a Spec 6 ainda
    // não escreveu regra de saída de membro em superPartnerships — no dia em
    // que escrever, um membro saindo no meio da rodada bateria o quórum por
    // tamanho sem que todo mundo presente tivesse votado, abrindo o voto
    // cedo sem erro nenhum.
    function roundClosed(spid, date) {
      let g = get(/databases/$(database)/documents/superPartnerships/$(spid)/games/$(date)).data;
      return g.voterUids.hasAll(superPartnership(spid).members)
          || todayNumber() > g.dayNumber;
    }

    function zeroStats() {
      return {
        'partnershipCount': 0,
        'totalXParceria': 0,
        'totalEncounters': 0,
        'daysUsing': 0,
        'strongestPartnershipId': null
      };
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Sem isto, qualquer um geraria um convite exibindo o nome e a foto de
    // outra pessoa — o vetor de engenharia social mais óbvio deste produto.
    // get(campo, null) pelo mesmo motivo de matchesUserProfile (abaixo): um
    // users doc pode não ter photoURL/avatarEmoji, e o acesso direto dava
    // erro e impedia essa pessoa de gerar convite.
    function matchesOwnProfile(p) {
      let u = userDoc(request.auth.uid);
      return p.get('displayName', null) == u.get('displayName', null)
          && p.get('photoURL', null) == u.get('photoURL', null)
          && p.get('avatarEmoji', null) == u.get('avatarEmoji', null)
          && p.get('handle', null) == u.get('handle', null);
    }

    // Convite ainda utilizável: pendente, não usado e dentro dos 7 dias
    // (INVITE_TTL_DAYS em shared/invite.ts). Um lugar só para as duas regras
    // que dependem disso — o aceite em invites e o nascimento da parceria —
    // não divergirem sobre o que é "convite válido".
    function inviteIsOpen(inv) {
      return inv.usedBy == null
          && inv.status == 'pending'
          && request.time < inv.createdAt + duration.value(7, 'd');
    }

    // O consentimento do outro lado: só existe parceria se quem convidou
    // gerou um convite aberto, e quem aceita não é a mesma pessoa. get(), não
    // getAfter(): o nascimento marca o convite como usado na mesma transação,
    // e get() enxerga o estado anterior — ainda pendente.
    function inviteAuthorizes(code, inviterUid, accepterUid) {
      let inv = get(/databases/$(database)/documents/invites/$(code)).data;
      return inv.fromUid == inviterUid
          && inv.fromUid != accepterUid
          && inviteIsOpen(inv);
    }

    // Convite ↔ parceria, nos DOIS sentidos (lição do furo rodada/voto):
    // inviteConsumedBy é o lado da parceria — ela só nasce se o mesmo commit
    // marcar o convite como usado por quem aceita. Sem isto, um convite de
    // uso único gerava uma parceria por pessoa que tivesse o código (provado
    // no emulador, Task 3). O outro sentido está em invites.update.
    function inviteConsumedBy(code, accepterUid) {
      let inv = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return inv.usedBy == accepterUid
          && inv.status == 'accepted';
    }

    // memberProfiles no nascimento é cópia de users/{uid} de cada membro —
    // os três campos de MemberProfile (shared/types.ts), que existem em
    // UserDoc. Sem isto, quem aceita escreveria o nome e a foto do OUTRO como
    // quisesse. A fonte é users e não invite.fromProfile: se a Alice editou o
    // perfil depois de gerar o convite, fromProfile está velho.
    //
    // get(campo, null) nos dois lados: users.create usa hasOnly, não hasAll,
    // então um users doc pode não ter photoURL/avatarEmoji. Chave ausente em
    // users só casa com ausente ou null no perfil — nunca com valor livre.
    // Com acesso direto (u.photoURL), a chave ausente dava erro e negava a
    // parceria inteira dessa pessoa.
    function matchesUserProfile(p, uid) {
      let u = userDoc(uid);
      return p.get('displayName', null) == u.get('displayName', null)
          && p.get('photoURL', null) == u.get('photoURL', null)
          && p.get('avatarEmoji', null) == u.get('avatarEmoji', null)
          && p.keys().hasOnly(['displayName', 'photoURL', 'avatarEmoji']);
    }

    function memberProfilesMatchUsers(profiles, members) {
      return profiles.keys().hasOnly(members)
          && matchesUserProfile(profiles[members[0]], members[0])
          && matchesUserProfile(profiles[members[1]], members[1]);
    }

    // O id da parceria de um par, na mesma forma que pidMatches exige.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // members[0] < members[1] garante ordem E proíbe parceria consigo mesmo.
    // A segunda parte é redundante: com members [x, x], createdBy e auth.uid
    // seriam ambos x, e `createdBy != auth.uid` já nega. Trocar < por <= não
    // deixa nenhum teste vermelho — é defesa em profundidade, não código morto.
    function pidMatches(pid, members) {
      return members.size() == 2
          && members[0] < members[1]
          && pid == members[0] + '_' + members[1];
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function allowedTransition(from, to) {
      return (from == 'active' && (to == 'paused' || to == 'ended'))
          || (from == 'paused' && (to == 'active' || to == 'ended'));
    }

    function isLifecycleEvent(t) {
      return t == 'partnership_born' || t == 'partnership_paused'
          || t == 'partnership_resumed' || t == 'partnership_ended';
    }

    // Só chamada depois de isLifecycleEvent — sem sentinel, sem furo.
    function lifecycleEventXp(t) {
      return t == 'partnership_born' ? 100 : 0;
    }

    // getAfter enxerga o estado PÓS-transação: é o que permite gravar o
    // evento de nascimento junto com a parceria que ainda está nascendo.
    function isMemberAfter(pid) {
      return isSignedIn() && request.auth.uid in
        getAfter(/databases/$(database)/documents/partnerships/$(pid)).data.members;
    }

    // O evento que narra uma mudança de status. A validade da transição é
    // da regra da parceria; aqui só importa que o evento conte o que ela fez.
    function eventForTransition(from, to) {
      return from == to ? null
           : to == 'paused' ? 'partnership_paused'
           : to == 'ended' ? 'partnership_ended'
           : to == 'active' ? 'partnership_resumed'
           : null;
    }

    // Evento ↔ parceria, sentido evento → parceria: o evento só existe se o
    // MESMO commit fizer o que ele narra. Sem isto, qualquer membro gravava
    // um partnership_born de 100 XP com id automático quantas vezes quisesse,
    // ou um "encerrou" que não aconteceu. Nascimento: id fixo `born` e a
    // parceria não existia antes. Reativação (ended → active): id = o código
    // do convite novo, que é o doc que a parceria confere no outro sentido.
    function eventMatchesWrite(pid, eventId, t) {
      let path = /databases/$(database)/documents/partnerships/$(pid);
      return t == 'partnership_born'
        ? eventId == 'born' && !exists(path)
        : exists(path)
            && eventForTransition(get(path).data.status, getAfter(path).data.status) == t
            && (get(path).data.status != 'ended' || eventId == getAfter(path).data.bornFromInvite);
    }

    // Evento ↔ parceria, sentido parceria → evento: o nascimento e a
    // reativação conferem, no estado pós-commit, o evento que deixam na
    // timeline. Pausar/retomar/encerrar não têm este sentido: o evento deles
    // tem id automático e a parceria não tem como saber qual conferir.
    function eventAfterIs(pid, eventId, t) {
      return getAfter(/databases/$(database)/documents/partnerships/$(pid)/events/$(eventId))
               .data.type == t;
    }

    // ---- partnerships: os três ramos de update -------------------------
    // Disjuntos por affectedKeys().hasOnly(...). Misturá-los num ramo só é
    // como se abre um buraco sem perceber.

    function lifecycleUpdate() {
      return isMember(resource.data)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['status', 'updatedAt'])
          && allowedTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.updatedAt == request.time;
    }

    // Reaceite sobre parceria `ended` (spec §2.3): mesmo documento, XParceria
    // e aniversário intactos, temperatura volta a 50. Mesmas amarras do
    // nascimento: convite aberto do outro membro (inviteAuthorizes), consumido
    // por quem aceita no mesmo commit (inviteConsumedBy — sem isto o uso único
    // voltava pelo update) e memberProfiles copiado de users.
    function reactivationUpdate(pid) {
      let after = request.resource.data;
      return isMember(resource.data)
          && resource.data.status == 'ended'
          && after.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'temperature', 'temperatureBand', 'memberProfiles',
                'bornFromInvite', 'updatedAt'])
          && after.status == 'active'
          && after.temperature == 50
          && after.temperatureBand == 'mild'
          && after.updatedAt == request.time
          && inviteAuthorizes(after.bornFromInvite,
                              otherMember(resource.data.members),
                              request.auth.uid)
          && inviteConsumedBy(after.bornFromInvite, request.auth.uid)
          && memberProfilesMatchUsers(after.memberProfiles, resource.data.members)
          && eventAfterIs(pid, after.bornFromInvite, 'partnership_resumed');
    }

    // Cada um propaga o próprio perfil (spec §2.5). O conteúdo é livre — o
    // dono pode pôr o que quiser no próprio users doc também —, mas o formato
    // é o de MemberProfile: sem o hasOnly, a entrada vira blob arbitrário, e
    // sem a entrada existir, apagá-la passaria (o diff só afeta a própria
    // chave). Igualdade, não hasOnly: hasOnly aceita o diff vazio, e um
    // update só de updatedAt (active → active) passaria por este ramo.
    function profileUpdate() {
      return isMember(resource.data)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberProfiles', 'updatedAt'])
          && request.resource.data.memberProfiles.diff(resource.data.memberProfiles)
               .affectedKeys() == [request.auth.uid].toSet()
          && request.resource.data.memberProfiles[request.auth.uid].keys()
               .hasOnly(['displayName', 'photoURL', 'avatarEmoji'])
          && request.resource.data.updatedAt == request.time;
    }

    function zeroStreak() {
      return { 'current': 0, 'longest': 0, 'lastDay': null, 'freezesLeft': 2 };
    }

    function zeroPartnershipStats() {
      return {
        'encounterCount': 0,
        'totalMinutesTogether': 0,
        'lastEncounterAt': null,
        'daysSinceLastEncounter': 0,
        'firstEncounterAt': null,
        'longestEncounterMinutes': 0,
        'maxDistanceKm': 0,
        'placesVisited': 0
      };
    }

    // ---- users ---------------------------------------------------------
    // Perfil é legível por qualquer autenticado (o mapa precisa de nome e
    // foto) — mas só get: list despejaria a coleção inteira (uid, handle,
    // displayName, photoURL, avatarEmoji, timezone, settings, stats) pra
    // qualquer autenticado de graça (Hole 4, revisão adversarial 2026-08-27).
    // stats e handle pertencem ao servidor / à transação de reivindicação.
    match /users/{uid} {
      allow get:  if isSignedIn();
      allow list: if false;

      // getAfter, não get: createProfile() (src/features/profile/services/
      // profile.ts) reivindica o handle em `handles/{handle}` e cria o
      // perfil na MESMA transação (provado em profile-transaction.test.ts,
      // que faz os dois tx.set juntos). get() enxerga o estado ANTES da
      // escrita da própria requisição — handles/{handle} ainda não existiria
      // — e negaria a criação legítima. getAfter() enxerga o estado depois
      // de toda a escrita da requisição, então vê os dois writes juntos.
      // Testado no emulador: com get() a primeira reivindicação de handle
      // (profile-transaction.test.ts) passa a falhar; com getAfter() ela
      // continua passando e a impersonação abaixo continua barrada.
      //
      // Sem este check (Hole 1, revisão adversarial 2026-08-27),
      // matchesOwnProfile() só comparava o convite contra users/{auth.uid}
      // — um documento que o próprio atacante escreve — sem nunca consultar
      // o registro que deveria tornar o handle único. O atacante escrevia
      // handle/displayName/photoURL/avatarEmoji da vítima no próprio
      // users/{uid} e matchesOwnProfile() passava.
      //
      // hasOnly com o shape de UserDoc (shared/types.ts): sem isto (Hole 5)
      // qualquer campo extra vira blob world-readable via `get`, igual ao
      // risco que já fecha em invites e questionSuggestions.
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.handle is string
                    && request.resource.data.stats == zeroStats()
                    && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'displayName', 'handle', 'photoURL', 'avatarEmoji', 'timezone',
                          'createdAt', 'lastActiveAt', 'stats', 'settings']);

      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.handle == resource.data.handle
                    && request.resource.data.stats == resource.data.stats
                    && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'displayName', 'handle', 'photoURL', 'avatarEmoji', 'timezone',
                          'createdAt', 'lastActiveAt', 'stats', 'settings']);

      allow delete: if false;
    }

    // ---- handles -------------------------------------------------------
    // Unicidade por criação: o Firestore recusa create em doc existente.
    // list nunca: enumerar a coleção dá o mapa handle→uid inteiro de graça
    // (Hole 4). Formato espelhado de handle ao vivo — mas users.handle é
    // imutável (:112) e handles não tem update/delete (:abaixo), então sem
    // este check nada aqui era corrigível depois: handle vazio, com 500
    // caracteres ou maiúsculo (confirmados pela revisão, Hole 2) ficavam
    // presos para sempre.
    match /handles/{handle} {
      allow get:    if isSignedIn();
      allow list:   if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && handle.matches('^[a-z0-9_.]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if false;
    }

    // ---- partnerships --------------------------------------------------
    // Sem Cloud Functions: esta regra é o servidor.
    match /partnerships/{pid} {
      allow read: if isMember(resource.data);

      // Todo valor é literal. Sem servidor, esta regra É o servidor: é o que
      // impede um número inventado de entrar no produto cuja moeda é o número.
      // updatedAt e o hasOnly vão além do brief da Task 3: a spec (§3.2) põe
      // updatedAt entre os literais, e um campo fora do shape de
      // PartnershipDoc (shared/types.ts) seria um valor que o cliente escolheu.
      allow create: if isSignedIn()
                    && pidMatches(pid, request.resource.data.members)
                    && request.resource.data.id == pid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy in request.resource.data.members
                    && request.resource.data.createdBy != request.auth.uid
                    && inviteAuthorizes(request.resource.data.bornFromInvite,
                                        request.resource.data.createdBy,
                                        request.auth.uid)
                    && inviteConsumedBy(request.resource.data.bornFromInvite, request.auth.uid)
                    && memberProfilesMatchUsers(request.resource.data.memberProfiles,
                                                request.resource.data.members)
                    && eventAfterIs(pid, 'born', 'partnership_born')
                    && request.resource.data.status == 'active'
                    && request.resource.data.xparceria == 100
                    && request.resource.data.level == 1
                    && request.resource.data.xpIntoLevel == 100
                    && request.resource.data.xpForNextLevel == 122
                    && request.resource.data.temperature == 50
                    && request.resource.data.temperatureBand == 'mild'
                    && request.resource.data.achievements == ['o-comeco']
                    && request.resource.data.superPartnershipId == null
                    && request.resource.data.streak == zeroStreak()
                    && request.resource.data.stats == zeroPartnershipStats()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.activatedAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.keys().hasOnly(
                         ['id', 'members', 'memberProfiles', 'status', 'createdBy', 'bornFromInvite',
                          'createdAt', 'activatedAt', 'xparceria', 'level', 'xpIntoLevel',
                          'xpForNextLevel', 'temperature', 'temperatureBand', 'streak', 'stats',
                          'achievements', 'superPartnershipId', 'updatedAt']);

      allow update: if lifecycleUpdate() || reactivationUpdate(pid) || profileUpdate();
      allow delete: if false;   // encerrar é mudar status, nunca apagar

      // Quando duas regras casam com o mesmo caminho, o acesso é concedido se
      // QUALQUER uma permitir. Este bloco convive com o /{document=**} abaixo,
      // que continua negando escrita em days, missions e insights.
      match /events/{eventId} {
        allow read:   if isMember(partnership(pid));
        allow create: if isMemberAfter(pid)
                      && isLifecycleEvent(request.resource.data.type)
                      && request.resource.data.xpAwarded
                           == lifecycleEventXp(request.resource.data.type)
                      && request.resource.data.occurredAt == request.time
                      && request.resource.data.keys().hasOnly(['type', 'occurredAt', 'xpAwarded'])
                      && eventMatchesWrite(pid, eventId, request.resource.data.type);
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read:  if isMember(partnership(pid));
        allow write: if false;
      }
    }

    // ---- presence ------------------------------------------------------
    // Sem parceria aceita, a localização não existe para você.
    match /presence/{uid} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      // hasOnly no shape de docs/2026-08-03-parceria-design.md §presence/{uid}:
      // sem isto (Hole 5) qualquer campo extra virava blob lido de volta por
      // quem estiver em visibleTo — mesmo risco que já fecha em users.
      allow create: if isOwner(uid)
                    && request.resource.data.visibleTo.size() == 0
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'location', 'accuracy', 'updatedAt', 'isStale', 'batteryLevel', 'visibleTo']);
      allow update: if isOwner(uid)
                    && request.resource.data.visibleTo == resource.data.visibleTo;
      allow delete: if isOwner(uid);
    }

    // ---- invites -------------------------------------------------------
    // Não há campo `expiresAt`: o cliente não consegue prever request.time,
    // então um vencimento gravado seria impossível de conferir — e convite
    // eterno é o abuso óbvio. Vencimento = createdAt + 7d, derivado.
    match /invites/{code} {
      // `get` sim, `list` não: com o código se lê um convite; sem ele não se
      // varre a coleção. São 32^8 ≈ 1,1 trilhão de códigos.
      allow get:  if isSignedIn();
      allow list: if false;

      // Qualquer autenticado dá `get` num invite pelo código (é assim que o
      // convidado vê quem chamou), então este documento é lido por gente de
      // fora do par convite/convidado. Sem o hasOnly, um cliente colaria
      // campo arbitrário aqui e outra pessoa o leria — mesmo risco que
      // questionSuggestions e a criação da rodada já fecham.
      allow create: if isOwner(request.resource.data.fromUid)
                    && request.resource.data.code == code
                    && request.resource.data.usedBy == null
                    && request.resource.data.status == 'pending'
                    && request.resource.data.maxUses == 1
                    && request.resource.data.createdAt == request.time
                    && matchesOwnProfile(request.resource.data.fromProfile)
                    && request.resource.data.keys().hasOnly(
                         ['code', 'fromUid', 'fromProfile', 'createdAt', 'usedBy', 'status', 'maxUses'])
                    && request.resource.data.fromProfile.keys().hasOnly(
                         ['displayName', 'photoURL', 'avatarEmoji', 'handle']);

      // Só a transição pendente → usado, e só por quem não é o dono.
      // isSignedIn() aqui é defesa em profundidade, não a única barreira:
      // para anônimo, request.auth é null e request.auth.uid abaixo já
      // vira erro de avaliação, que nega sozinho. Não é código morto —
      // é redundância deliberada, não remova sem entender isso.
      // Vencimento = createdAt + INVITE_TTL_DAYS (shared/invite.ts, hoje 7
      // dias), verificado aqui de verdade, não só no comentário: sem isto
      // (Hole 3, revisão adversarial 2026-08-27), a regra nunca lia
      // createdAt e um convite de 100 dias ainda era aceito. Confirmado no
      // emulador que Timestamp + duration.value(n, 'd') funciona em regra.
      // usedBy, status e vencimento moram em inviteIsOpen(), compartilhada com
      // o nascimento da parceria.
      //
      // O getAfter da parceria é o segundo sentido do acoplamento (o primeiro
      // é inviteConsumedBy): sem ele qualquer logado com o código queimava o
      // convite sem parceria nenhuma nascer. Ele pede que, depois do commit, a
      // parceria do par aponte para ESTE código — não que ela esteja sendo
      // criada agora. Assim o mesmo ramo serve à reativação (Task 4), em que a
      // parceria `ended` já existe e passa a apontar para o código novo.
      allow update: if isSignedIn()
                    && inviteIsOpen(resource.data)
                    && request.auth.uid != resource.data.fromUid
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.status == 'accepted'
                    && getAfter(/databases/$(database)/documents/partnerships/$(pairId(resource.data.fromUid, request.auth.uid)))
                         .data.bornFromInvite == code
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['usedBy', 'status']);

      allow delete: if false;
    }

    // ---- jogo diário ---------------------------------------------------

    match /gameQuestions/{qid} {
      // O catálogo é curado à mão pelo console. Nenhum cliente escreve aqui:
      // quem escrevesse trocaria a pergunta do dia do app inteiro.
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /questionSuggestions/{sid} {
      // Fila só de entrada: escreve e some da vista. Ninguém lê pelo app, nem
      // quem escreveu — leitura transformaria isso num canal de mensagem sem
      // moderação entre usuários.
      allow create: if isOwner(request.resource.data.suggestedBy)
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 10
                    && request.resource.data.text.size() <= 140
                    && request.resource.data.suggestedAt == request.time
                    && request.resource.data.keys().hasOnly(['text', 'suggestedBy', 'suggestedAt']);
      allow read, update, delete: if false;
    }

    // A Spec 6 é quem é dona deste documento — quando ela for escrita, este
    // bloco provavelmente cresce. Até lá, ele existe só para não deixar
    // `members` mutável por acidente: sem uma regra explícita aqui, o path
    // caía no catch-all (`allow read, write: if false` no fim do arquivo),
    // que por coincidência também bloqueava update — proteção sem intenção,
    // fácil de perder quando alguém escrever a regra de verdade sem saber
    // o que depende de `members` não mudar. Duas coisas dependem: a
    // roundClosed() acima compara `voterUids.hasAll(members)`, e gameXp()
    // lê `members.size()` ao vivo em cada write da rodada. Um membro saindo
    // no meio de uma rodada, com `members` mutável, travaria `xpAwarded` em
    // 6 para sempre — todo mundo que ficou já votou, então nenhum update
    // novo bateria mais o quórum. `members` é imutável pela vida inteira da
    // Super Parceria até a Spec 6 decidir o contrário de propósito.
    match /superPartnerships/{spid} {
      allow read: if isMember(resource.data);
      allow create, delete: if false;
      allow update: if false;
    }

    // O resto do que a Spec 6 vai precisar do documento acima (nome, emoji,
    // status, xparceria de grupo etc.) continua em aberto — aqui só existe
    // o que o jogo diário precisa.
    match /superPartnerships/{spid}/games/{date} {
      allow read: if isMember(superPartnership(spid));

      // O create e o update só amarravam voterUids -> voto num sentido: o
      // voto exige (via getAfter, abaixo) que o votante já esteja em
      // voterUids, mas nada aqui exigia o inverso. Sem o existsAfter, dava
      // para entrar em voterUids sozinho, sem nunca escrever um voto — a
      // rodada fechava (hasAll batia) e quem fez isso lia o voto de todo
      // mundo antes de votar. O existsAfter fecha o outro sentido: exige que
      // o voto do próprio uid já exista depois da transação, então voto e
      // entrada em voterUids só acontecem juntos, dos dois lados.
      // "Super Parceria é trio ou mais" (§2 do design doc) é convenção de
      // produto, nada aqui a fazia valer. Sem isto, gameXp(1, members.size())
      // pagando 15 para um grupo de 1 membro só ficava inalcançável porque
      // nenhum fluxo de hoje cria Super Parceria fora de 3–8 — um caso vivo,
      // não um caso impossível. Pinar os limites aqui faz o caso deixar de
      // existir, em vez de continuar dependendo de uma convenção que nenhum
      // código prende.
      allow create: if isMember(superPartnership(spid))
                    && superPartnership(spid).members.size() >= 3
                    && superPartnership(spid).members.size() <= 8
                    && request.resource.data.date == date
                    && request.resource.data.date == todayId()
                    && request.resource.data.dayNumber == todayNumber()
                    && request.resource.data.questionId == questionOfTheDay()
                    && request.resource.data.voterUids == [request.auth.uid]
                    && request.resource.data.xpAwarded ==
                         gameXp(1, superPartnership(spid).members.size())
                    && request.resource.data.keys().hasOnly(
                         ['date', 'dayNumber', 'questionId', 'voterUids', 'xpAwarded'])
                    && existsAfter(
                         /databases/$(database)/documents/superPartnerships/$(spid)/games/$(date)/votes/$(request.auth.uid));

      allow update: if isMember(superPartnership(spid))
                    && superPartnership(spid).members.size() >= 3
                    && superPartnership(spid).members.size() <= 8
                    && resource.data.dayNumber == todayNumber()
                    && !(request.auth.uid in resource.data.voterUids)
                    && request.resource.data.voterUids ==
                         resource.data.voterUids.concat([request.auth.uid])
                    && request.resource.data.xpAwarded ==
                         gameXp(request.resource.data.voterUids.size(),
                                superPartnership(spid).members.size())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['voterUids', 'xpAwarded'])
                    && existsAfter(
                         /databases/$(database)/documents/superPartnerships/$(spid)/games/$(date)/votes/$(request.auth.uid));

      allow delete: if false;

      match /votes/{voter} {
        // O próprio voto é sempre legível — senão a pessoa não consegue reler
        // o que votou. O dos outros, só depois que a rodada fecha. O ramo do
        // dono não checa isMember de propósito: checar custaria um get() na
        // leitura mais frequente da feature, e o documento só existe se a
        // pessoa votou (create já exige isMember) — não há vazamento a
        // fechar, só um get() a economizar.
        allow get:  if isOwner(voter)
                    || (isMember(superPartnership(spid)) && roundClosed(spid, date));

        // list não tem exceção para o próprio voto: listar devolveria os
        // outros junto. E isMember aqui não é opcional como no get: sem ele,
        // qualquer logado listaria os votos de qualquer rodada fechada de
        // qualquer grupo — e é o list que a apuração usa, não o get.
        allow list: if isMember(superPartnership(spid)) && roundClosed(spid, date);

        // O getAfter enxerga o estado pós-transação (provado na Spec 2), então
        // a regra consegue exigir que o voto e a entrada em voterUids sejam
        // escritos juntos. Sem isso daria para votar sem aparecer como votante.
        //
        // isMember aqui é defesa em profundidade, não a única barreira: hoje
        // quem não é do grupo já não entraria em voterUids, então nunca bate
        // o getAfter acima. Mas se a regra da rodada afrouxar essa checagem
        // um dia, esta linha continua barrando o voto sozinha — mesmo padrão
        // do isSignedIn() redundante em invites.update.
        allow create: if isOwner(voter)
                      && isMember(superPartnership(spid))
                      && request.resource.data.votedFor in superPartnership(spid).members
                      && request.resource.data.votedAt == request.time
                      && request.resource.data.keys().hasOnly(['votedFor', 'votedAt'])
                      && getAfter(
                           /databases/$(database)/documents/superPartnerships/$(spid)/games/$(date)
                         ).data.voterUids.hasAll([voter]);

        allow update, delete: if false;
      }
    }

    // ---- padrão --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
